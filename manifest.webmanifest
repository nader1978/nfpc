{
  "name": "ORBIT Mobile",
  "short_name": "ORBIT",
  "description": "ORBIT field app — vehicle ODO, temperature, rack counts, put-away and stock moves.",
  "id": "./mobile.html",
  "start_url": "./mobile.html?source=homescreen",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#0a1022",
  "theme_color": "#0f1a3a",
  "icons": [
    { "src": "icons/orbit-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/orbit-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/orbit-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
